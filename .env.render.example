APP_ENV=render
NODE_ENV=production
MAIN_API_PORT=10000
ADMIN_API_PORT=10000
CHECKIN_API_PORT=10000
SUPER_ADMIN_API_PORT=10000
DATABASE_URL=SET_IN_RENDER_DASHBOARD
PLATFORM_DATABASE_URL=SET_IN_RENDER_DASHBOARD
JWT_SECRET=SET_IN_RENDER_DASHBOARD_MINIMUM_32_RANDOM_CHARACTERS
PLATFORM_JWT_SECRET=SET_IN_RENDER_DASHBOARD_MINIMUM_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=2h
PLATFORM_JWT_EXPIRES_IN=1h
JWT_ISSUER=crit-api
JWT_AUDIENCE=crit-assist
PLATFORM_JWT_ISSUER=crit-api-platform
PLATFORM_JWT_AUDIENCE=crit-assist-platform
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=https://SET_YOUR_RENDER_FRONTEND_DOMAIN
COOKIE_SECURE=true
BEARER_AUTH_ENABLED=false
OPENAPI_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
CRIT_POST_API_URL=
CRIT_POST_API_TOKEN=
AI_ENABLED=false
AI_RUNTIME=local
AI_WORKER_TENANT_IDS=SET_DEMO_TENANT_UUID
AI_EMBEDDING_COMMAND=python /app/runtime/ai_runtime.py embed
AI_GENERATION_COMMAND=python /app/runtime/ai_runtime.py generate
AI_EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
AI_EMBEDDING_MODEL_REVISION=SET_PINNED_REVISION
AI_EMBEDDING_MODEL_SHA256=SET_64_CHARACTER_SHA256
AI_GENERATION_MODEL_ID=Qwen3-1.7B-Q4_K_M
AI_GENERATION_MODEL_REVISION=SET_PINNED_REVISION
AI_GENERATION_MODEL_SHA256=SET_64_CHARACTER_SHA256
AI_SIMILARITY_THRESHOLD=0.70
AI_JOB_TIMEOUT_MS=240000
AI_POLL_INTERVAL_MS=5000
AI_INTERACTION_RETENTION_DAYS=90
