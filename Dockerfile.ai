FROM node:22-bookworm-slim AS api-build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:22-bookworm-slim AS runtime
ARG LLAMA_CPP_COMMIT
RUN test -n "$LLAMA_CPP_COMMIT"
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates cmake g++ git libgomp1 python3 python3-venv \
    && git clone https://github.com/ggml-org/llama.cpp.git /tmp/llama.cpp \
    && git -C /tmp/llama.cpp checkout "$LLAMA_CPP_COMMIT" \
    && cmake -S /tmp/llama.cpp -B /tmp/llama.cpp/build -DLLAMA_BUILD_SERVER=OFF \
    && cmake --build /tmp/llama.cpp/build --config Release -j2 \
    && mkdir -p /opt/llama.cpp \
    && cp /tmp/llama.cpp/build/bin/llama-cli /opt/llama.cpp/llama-cli \
    && rm -rf /tmp/llama.cpp /var/lib/apt/lists/*

WORKDIR /app
COPY ai-runtime/requirements.txt /app/ai-runtime/requirements.txt
RUN python3 -m venv /opt/ai-venv \
    && /opt/ai-venv/bin/pip install --no-cache-dir -r /app/ai-runtime/requirements.txt
COPY ai-runtime/download_models.py /app/ai-runtime/download_models.py
ARG E5_MODEL_REVISION
ARG E5_MODEL_SHA256
ARG QWEN_MODEL_REVISION
ARG QWEN_MODEL_SHA256
RUN test -n "$E5_MODEL_REVISION" \
    && test -n "$E5_MODEL_SHA256" \
    && test -n "$QWEN_MODEL_REVISION" \
    && test -n "$QWEN_MODEL_SHA256" \
    && E5_MODEL_REVISION="$E5_MODEL_REVISION" \
       E5_MODEL_SHA256="$E5_MODEL_SHA256" \
       QWEN_MODEL_REVISION="$QWEN_MODEL_REVISION" \
       QWEN_MODEL_SHA256="$QWEN_MODEL_SHA256" \
       /opt/ai-venv/bin/python /app/ai-runtime/download_models.py
COPY --from=api-build /app/node_modules ./node_modules
COPY --from=api-build /app/dist ./dist
COPY ai-runtime/ai_runtime.py /app/ai-runtime/ai_runtime.py

ENV NODE_ENV=production \
    PATH="/opt/ai-venv/bin:$PATH" \
    AI_RUNTIME=local \
    AI_EMBEDDING_COMMAND="python /app/ai-runtime/ai_runtime.py embed" \
    AI_GENERATION_COMMAND="python /app/ai-runtime/ai_runtime.py generate" \
    AI_EMBEDDING_MODEL_PATH="/opt/models/multilingual-e5-small" \
    AI_GENERATION_MODEL_PATH="/opt/models/qwen3-1.7b/Qwen3-1.7B-Q4_K_M.gguf" \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

USER 10001
CMD ["node", "dist/workers/ai.worker.js"]
