APP_ENV=production
NODE_ENV=production
MAIN_API_PORT=3000
ADMIN_API_PORT=3001
CHECKIN_API_PORT=3002
SUPER_ADMIN_API_PORT=3003
DATABASE_URL=INJECT_FROM_AWS_SECRETS_MANAGER
PLATFORM_DATABASE_URL=INJECT_FROM_AWS_SECRETS_MANAGER
JWT_SECRET=INJECT_RANDOM_SECRET_MINIMUM_32_CHARACTERS
PLATFORM_JWT_SECRET=INJECT_RANDOM_SECRET_MINIMUM_32_CHARACTERS
JWT_EXPIRES_IN=1h
PLATFORM_JWT_EXPIRES_IN=30m
JWT_ISSUER=crit-api
JWT_AUDIENCE=crit-assist
PLATFORM_JWT_ISSUER=crit-api-platform
PLATFORM_JWT_AUDIENCE=crit-assist-platform
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=https://SET_PRODUCTION_DOMAIN
COOKIE_SECURE=true
BEARER_AUTH_ENABLED=false
OPENAPI_ENABLED=false
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=5
CRIT_POST_API_URL=
CRIT_POST_API_TOKEN=
