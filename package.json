{
  "name": "crit-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:main": "tsx watch src/apps/main-api/server.ts",
    "dev:admin": "tsx watch src/apps/admin-api/server.ts",
    "dev:checkin": "tsx watch src/apps/checkin-api/server.ts",
    "dev:super-admin": "tsx watch src/apps/super-admin-api/server.ts",
    "build": "tsc --noEmit",
    "db:check": "tsx src/scripts/check-db.ts",
    "admin:bootstrap": "tsx src/scripts/bootstrap-admin.ts",
    "platform:bootstrap-super-admin": "tsx src/scripts/bootstrap-super-admin.ts",
    "test:integration": "tsx src/scripts/test-m1-integration.ts",
    "test:outbox-integration": "tsx src/scripts/test-outbox-integration.ts",
    "worker:crit-post-api": "tsx src/workers/crit-post-api.worker.ts",
    "worker:crit-post-api:once": "tsx src/workers/crit-post-api.worker.ts --once",
    "lint": "echo \"Lint not configured yet\"",
    "test": "tsx --test --test-isolation=none --test-concurrency=1 src/**/*.test.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
